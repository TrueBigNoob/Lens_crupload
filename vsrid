import base64
import os
import random
import time
from typing import Tuple
from playwright.sync_api import Page


def encode_varint(n: int) -> bytes:
    out = bytearray()
    while n >= 0x80:
        out.append((n & 0x7F) | 0x80)
        n >>= 7
    out.append(n & 0x7F)
    return bytes(out)


def decode_varint(data: bytes, offset: int = 0) -> Tuple[int, int]:
    res = 0
    shift = 0
    pos = offset
    while True:
        b = data[pos]
        res |= (b & 0x7F) << shift
        pos += 1
        shift += 7
        if not (b & 0x80):
            break
    return res, pos - offset


def pack_lens_protobuf_and_slices(image_bytes: bytes, mime_type: str) -> Tuple[bytes, bytes, bytes]:
    tag1_corr = b'\x08\xa5\xbe\xec\xf0\xb3\xe1\x81' + bytes([random.randint(128, 255), random.randint(128, 255), 1])
    uuid_16 = bytes([random.randint(0, 255) for _ in range(16)])
    timestamp_micros = int(time.time() * 1000000)
    mime_bytes = mime_type.encode('utf-8')

    vsrid_header = tag1_corr + b'\x10\x01\x18\x01\x22\x10' + uuid_16
    vsrid_tail = (
        b'\x38' + encode_varint(timestamp_micros) +
        b'\x50\x00' +
        b'\x6a' + encode_varint(len(mime_bytes)) + mime_bytes
    )

    sub_tag3 = vsrid_header + vsrid_tail
    meta_tag3 = b'\x1a' + encode_varint(len(sub_tag3)) + sub_tag3
    meta_tag4 = b'\x22\x04\x08\x03\x10\x26'
    meta_container = b'\x0a' + encode_varint(len(meta_tag3 + meta_tag4)) + meta_tag3 + meta_tag4

    img_inner = b'\x0a' + encode_varint(len(image_bytes)) + image_bytes
    img_mid = b'\x0a' + encode_varint(len(img_inner)) + img_inner
    img_outer = b'\x1a' + encode_varint(len(img_mid)) + img_mid

    root_payload = meta_container + img_outer
    proto_packet = b'\x0a' + encode_varint(len(root_payload)) + root_payload
    return proto_packet, vsrid_header, vsrid_tail


def extract_complete_server_ticket(server_raw_bytes: bytes) -> bytes:
    anchor = server_raw_bytes.find(b'lfe-dummy:')
    if anchor == -1:
        anchor = server_raw_bytes.find(b'lens-frontend-api')
    if anchor == -1:
        raise ValueError("Cluster description anchor not found in server response")

    tag6_start = server_raw_bytes.rfind(b'\x32', 0, anchor)
    if tag6_start == -1:
        raise ValueError("Tag 6 (0x32) start marker not found")

    length, len_bytes_count = decode_varint(server_raw_bytes, tag6_start + 1)
    tag6_total_len = 1 + len_bytes_count + length
    return server_raw_bytes[tag6_start : tag6_start + tag6_total_len]


def upload_image_and_get_vsrid(page: Page, image_path: str) -> str:
    """
    Encapsulates local image into Lens Protobuf wire format, 
    uploads directly to Google Lens API via active session, 
    and synthesizes a valid vsrid token.
    """
    with open(image_path, "rb") as f:
        image_bytes = f.read()

    mime_type = "image/png"
    if image_bytes.startswith(b'\xff\xd8'):
        mime_type = "image/jpeg"
    elif image_bytes.startswith(b'RIFF') and b'WEBP' in image_bytes[:16]:
        mime_type = "image/webp"

    proto_packet, vsrid_header, vsrid_tail = pack_lens_protobuf_and_slices(image_bytes, mime_type)
    payload_b64 = base64.b64encode(proto_packet).decode('ascii')

    upload_res = page.evaluate("""async (payloadB64) => {
        const binaryString = atob(payloadB64);
        const bytes = new Uint8Array(binaryString.length);
        for (let i = 0; i < binaryString.length; i++) bytes[i] = binaryString.charCodeAt(i);

        const sapisidCookie = document.cookie.match(/SAPISID=([^;]+)/);
        if (!sapisidCookie) return { success: false, error: "Missing SAPISID cookie" };
        const sapisid = sapisidCookie[1];

        const time = Math.round(Date.now() / 1000);
        const signText = `${time} ${sapisid} https://www.google.com`;
        const signData = new TextEncoder().encode(signText);
        const hashBuffer = await crypto.subtle.digest('SHA-1', signData);
        const hashArray = Array.from(new Uint8Array(hashBuffer));
        const hashHex = hashArray.map(b => b.toString(16).padStart(2, '0')).join('');
        const authHeader = `SAPISIDHASH ${time}_${hashHex} SAPISID1PHASH ${time}_${hashHex} SAPISID3PHASH ${time}_${hashHex}`;

        const res = await fetch('https://lensfrontend-pa.clients6.google.com/v1/crupload', {
            method: 'POST',
            mode: 'cors',
            credentials: 'include',
            headers: {
                'Content-Type': 'application/x-protobuf',
                'Authorization': authHeader,
                'X-Client-Data': window.google?.kXClientData || '',
                'X-Goog-Api-Key': 'AIzaSyBwQcjgmXUAsw5r4FZXO5t8_EZ_aUm_TGE',
                'X-Goog-AuthUser': '0',
                'X-Goog-Encode-Response-If-Executable': 'base64'
            },
            body: bytes
        });

        if (!res.ok) return { success: false, status: res.status };
        const arrayBuffer = await res.arrayBuffer();
        return { success: true, rawBase64: new TextDecoder().decode(new Uint8Array(arrayBuffer)).trim() };
    }""", payload_b64)

    if not upload_res.get("success"):
        raise RuntimeError(f"Google Lens image upload failed: {upload_res}")

    server_raw_bytes = base64.b64decode(upload_res["rawBase64"])
    server_ticket = extract_complete_server_ticket(server_raw_bytes)

    vsrid_binary = vsrid_header + server_ticket + vsrid_tail
    return base64.urlsafe_b64encode(vsrid_binary).decode('ascii').rstrip('=')
